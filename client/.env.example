# --- Shreeji & Shreeji frontend env ---
# Copy to .env and fill in real values. Never commit .env.

# Backend base URL (no trailing slash, no /api suffix).
# Leave empty in local dev to use the Vite /api proxy.
# Production example: https://shreeji-shreeji-api.onrender.com
VITE_API_URL=

# Google Maps API key (Places API enabled) for address autocomplete
VITE_GOOGLE_MAPS_API_KEY=<redacted>
