# ---- Server ----
PORT=5000

# ---- Database (MongoDB Atlas connection string) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# ---- Auth (self-contained: name + mobile sign-in, NO external auth system) ----
# Long random string used to sign login tokens. Keep secret, never commit.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- Admin access ----
# Admin signs in with one of these mobile numbers (no OTP — just name + mobile).
# Comma-separated for multiple admins. Use E.164 format, e.g. +919829012345,+919876543210
ADMIN_PHONE_NUMBERS=9829012345  # your 10-digit mobile number; any format works (+919829012345, 919829012345, +91 98290 12345)

# ---- Merchant UPI (manual UPI collection — the active payment path) ----
# Your business UPI ID. Customers pay to this in their own UPI app and submit
# the 12-digit UTR; you verify each payment manually in the admin panel.
MERCHANT_UPI_ID=yourupi@bank
MERCHANT_NAME=Shreeji & Shreeji

# ---- Razorpay (automatic UPI payment verification) ----
# Get these from razorpay.com dashboard (use test keys starting with rzp_test_ first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Generated when you create the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ---- Google Maps (frontend address autocomplete) ----
GOOGLE_MAPS_API_KEY=

# ---- URLs ----
# Comma-separated allowed frontend origins (production)
FRONTEND_URL=http://localhost:5173
# Public URL of this backend (used by cron keep-alive)
BACKEND_URL=http://localhost:5000

# ---- Keep-alive cron (Render Free) ----
CRON_ENABLED=true
# Interval in milliseconds (14 minutes default)
CRON_INTERVAL=840000
